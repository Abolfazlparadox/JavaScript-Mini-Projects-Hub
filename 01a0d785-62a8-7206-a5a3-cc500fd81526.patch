+.field { background: rgba(0,0,0,0.35); border: 1px solid var(--border); color: var(--text); border-radius: var(--r-md); padding: 0.55rem 0.75rem; font-family: var(--font-main); font-size: 0.86rem; outline: none; color-scheme: dark; }
+.field:focus { border-color: var(--accent); }
+.field-sm { font-size: 0.8rem; border-radius: var(--r-sm); flex-shrink: 0; }
+#optInput { flex: 1; min-width: 0; }
+select.field option { background: var(--surface-solid); }
+.btn-primary { background: var(--accent); color: #fff; border: none; border-radius: var(--r-md); padding: 0.6rem 1.3rem; font-family: var(--font-main); font-size: 0.86rem; font-weight: 700; cursor: pointer; transition: all var(--t); }
+.btn-primary:hover { background: var(--accent-hover); }
+.btn-primary.sm { padding: 0.55rem 1rem; font-size: 0.8rem; flex-shrink: 0; }
+.btn-ghost { background: rgba(255,255,255,0.05); border: 1px solid var(--border); color: var(--text); border-radius: var(--r-md); padding: 0.55rem 0.9rem; font-size: 0.8rem; font-weight: 600; font-family: var(--font-main); cursor: pointer; transition: all var(--t); }
+.btn-ghost:hover { background: rgba(255,255,255,0.12); }
+.btn-ghost.sm { font-size: 0.76rem; }
+.btn-ghost.danger { color: #fca5a5; }
+.opt-list { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; max-height: 240px; overflow-y: auto; margin-bottom: 0.8rem; }
+.opt-list li { display: flex; align-items: center; gap: 0.6rem; background: rgba(0,0,0,0.3); border: 1px solid var(--border); border-radius: var(--r-sm); padding: 0.5rem 0.7rem; font-size: 0.84rem; }
+.opt-list li .dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }
+.opt-list li span { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.opt-list li small { font-family: var(--font-mono); color: var(--dim); font-size: 0.7rem; }
+.opt-list li button { background: transparent; border: none; color: var(--dim); cursor: pointer; font-size: 0.8rem; }
+.opt-list li button:hover { color: #fca5a5; }
+.opt-tools { display: flex; gap: 0.5rem; margin-bottom: 1.1rem; }
+.hist-title { border-top: 1px solid var(--border); padding-top: 1rem; }
+.hist-list { list-style: none; display: flex; flex-direction: column; gap: 0.35rem; max-height: 150px; overflow-y: auto; }
+.hist-list li { display: flex; justify-content: space-between; font-size: 0.78rem; font-family: var(--font-mono); color: var(--muted); background: rgba(0,0,0,0.25); border: 1px solid var(--border); border-radius: var(--r-sm); padding: 0.4rem 0.7rem; }
+.hist-list li b { color: #fcd34d; }
+/* Winner modal + confetti */
