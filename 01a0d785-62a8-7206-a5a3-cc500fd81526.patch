+.icon-btn:hover { background: rgba(255,255,255,0.14); transform: translateY(-2px); }
+.cw-stage { flex: 1; display: flex; justify-content: center; padding: 1.6rem 1rem 3rem; }
+.cw-shell { width: 100%; max-width: 1060px; display: grid; grid-template-columns: 1.1fr 1fr; gap: 1rem; align-items: start; }
