+.spin-hub { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 92px; height: 92px; border-radius: 50%; border: 4px solid rgba(255,255,255,0.25); background: radial-gradient(circle at 35% 30%, #818cf8, #4f46e5); color: #fff; font-family: var(--font-main); font-weight: 800; font-size: 1rem; letter-spacing: 0.08em; cursor: pointer; z-index: 3; box-shadow: 0 8px 26px rgba(99,102,241,0.55); transition: transform var(--t); }
