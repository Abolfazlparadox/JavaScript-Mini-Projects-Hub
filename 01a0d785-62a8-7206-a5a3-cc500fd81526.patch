+.winner-card { position: relative; width: 100%; max-width: 480px; overflow: hidden; text-align: center; padding: 0; }
+#confettiCanvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
+.winner-inner { position: relative; padding: 2.2rem 1.6rem; }
+.winner-crown { font-size: 3.2rem; display: block; animation: bounce 0.9s infinite alternate; }
+@keyframes bounce { to { transform: translateY(-10px) rotate(-6deg); } }
+.winner-inner h3 { font-size: 1.1rem; color: var(--muted); margin: 0.4rem 0; }
+.winner-name { font-size: 1.9rem; font-weight: 800; margin-bottom: 1.4rem; background: linear-gradient(135deg, #fcd34d, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; word-break: break-word; }
+.winner-btns { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; }
+.toast-container { position: fixed; bottom: 1.5rem; right: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; z-index: 200; }
+.toast { background: #1e293b; border: 1px solid var(--border); color: var(--text); padding: 0.65rem 1.15rem; border-radius: var(--r-full); font-size: 0.85rem; font-weight: 600; box-shadow: var(--shadow); }
+.toast.success { border-color: rgba(16,185,129,0.5); }
+.hidden { display: none !important; }
+@media (max-width: 900px) { .cw-shell { grid-template-columns: 1fr; } }
