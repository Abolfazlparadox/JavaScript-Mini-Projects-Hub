@@ -0,0 +1,121 @@
+<!DOCTYPE html>
+<html lang="en" data-theme="dark">
+  <head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>SpendWise | Smart Expense Tracker</title>
+    <meta name="description" content="Track spending with budgets, category analytics, canvas charts, filters and CSV export." />
+    <link rel="preconnect" href="https://fonts.googleapis.com" />
+    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
+    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
+    <link rel="stylesheet" href="styles.css" />
+  </head>
+  <body>
+    <header class="sw-header">
+      <div class="header-left">
+        <a href="../../index.html" class="nav-hub-btn" title="Return to Projects Hub">
+          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
+          <span>Hub</span>
+        </a>
+        <div class="brand"><span class="brand-badge">#20</span><span class="brand-title">SpendWise</span></div>
+      </div>
+      <div class="header-right">
+        <button class="icon-btn" id="btnExport" title="Export CSV">📥</button>
+        <button class="icon-btn" id="btnBudget" title="Set monthly budget (B)">🎯</button>
+      </div>
+    </header>
+
+    <main class="sw-stage">
+      <div class="sw-shell">
+        <section class="glass-card overview" aria-label="Month overview">
+          <div class="month-nav">
+            <button class="mini-btn" id="btnPrevMonth" title="Previous month">◀</button>
+            <h2 id="monthLabel">—</h2>
+            <button class="mini-btn" id="btnNextMonth" title="Next month">▶</button>
+          </div>
+          <div class="ov-grid">
+            <div class="ring-wrap">
+              <svg width="110" height="110" viewBox="0 0 110 110">
+                <circle class="ring-track" cx="55" cy="55" r="46"></circle>
+                <circle class="ring-fill" id="budgetRing" cx="55" cy="55" r="46"></circle>
+              </svg>
+              <div class="ring-center"><span class="ring-pct" id="budgetPct">0%</span><span class="ring-sub">of budget</span></div>
+            </div>
+            <div class="ov-stats">
+              <div class="ov-stat"><span>Spent</span><strong id="statSpent" class="neg">$0</strong></div>
+              <div class="ov-stat"><span>Budget</span><strong id="statBudget">$0</strong></div>
+              <div class="ov-stat"><span>Remaining</span><strong id="statLeft" class="pos">$0</strong></div>
+              <div class="ov-stat"><span>Transactions</span><strong id="statCount">0</strong></div>
+            </div>
+          </div>
+        </section>
+
+        <div class="two-col">
+          <section class="glass-card" aria-label="Add expense">
+            <h2>＋ Add Expense <kbd>N</kbd></h2>
+            <div class="form-grid">
+              <input type="text" id="fTitle" class="field" placeholder="What did you buy?" maxlength="60" />
+              <input type="number" id="fAmount" class="field" placeholder="Amount ($)" min="0" step="0.01" />
+              <select id="fCategory" class="field">
+                <option value="food">🍔 Food & Drink</option>
+                <option value="transport">🚕 Transport</option>
+                <option value="housing">🏠 Housing</option>
+                <option value="shopping">🛍️ Shopping</option>
+                <option value="health">💊 Health</option>
+                <option value="fun">🎮 Fun & Games</option>
+                <option value="bills">💡 Bills</option>
+                <option value="other">📦 Other</option>
+              </select>
+              <input type="date" id="fDate" class="field" />
+              <button class="btn-primary" id="btnAdd">Add Expense</button>
+            </div>
+          </section>
+
+          <section class="glass-card" aria-label="Analytics">
+            <h2>📊 By Category</h2>
+            <div class="chart-wrap"><canvas id="donutCanvas"></canvas></div>
+            <div class="legend" id="legend"></div>
+          </section>
+        </div>
+
+        <section class="glass-card" aria-label="History">
