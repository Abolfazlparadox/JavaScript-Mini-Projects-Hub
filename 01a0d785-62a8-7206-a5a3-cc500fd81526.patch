+
+    <main class="task-stage">
+      <div class="task-shell">
+        <!-- Stats ribbon -->
+        <section class="glass-card stats-ribbon" aria-label="Task statistics">
+          <div class="ring-wrap">
+            <svg class="progress-ring" width="92" height="92" viewBox="0 0 92 92">
+              <circle class="ring-track" cx="46" cy="46" r="38"></circle>
