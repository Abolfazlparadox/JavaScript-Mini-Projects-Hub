+  <body>
+    <header class="md-header">
+      <div class="header-left">
+        <a href="../../index.html" class="nav-hub-btn" title="Return to Projects Hub">
+          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
+          <span>Hub</span>
+        </a>
+        <div class="brand"><span class="brand-badge">#26</span><span class="brand-title">MemoDeck</span></div>
+      </div>
+      <div class="header-right">
+        <button class="hdr-btn" id="btnStudy" title="Start study session (S)">🎓 Study</button>
+        <button class="icon-btn" id="btnAddDeck" title="New deck (D)">📚</button>
+        <button class="icon-btn" id="btnAddCard" title="New card (N)">＋</button>
+      </div>
+    </header>
+
+    <main class="md-stage">
+      <!-- Library view -->
+      <div class="md-shell" id="libraryView">
+        <section class="glass-card stats-bar" aria-label="Statistics">
+          <div class="stat"><span class="stat-num" id="statDecks">0</span><span class="stat-label">Decks</span></div>
+          <div class="stat"><span class="stat-num" id="statCards">0</span><span class="stat-label">Cards</span></div>
+          <div class="stat"><span class="stat-num accent" id="statDue">0</span><span class="stat-label">Due now</span></div>
+          <div class="stat"><span class="stat-num green" id="statRetention">—</span><span class="stat-label">Retention</span></div>
+        </section>
+        <section class="deck-grid" id="deckGrid" aria-label="Decks"></section>
+        <div class="empty-state glass-card hidden" id="emptyState">
+          <span class="empty-icon">🎴</span><h3>No decks yet</h3><p>Create a deck and add your first cards!</p>
+        </div>
+      </div>
+
+      <!-- Study view -->
+      <div class="md-shell hidden" id="studyView">
+        <section class="glass-card study-top">
+          <button class="btn-ghost sm" id="btnExitStudy">← Library</button>
+          <div class="study-progress"><div class="study-fill" id="studyFill"></div></div>
+          <span class="study-count" id="studyCount">0 / 0</span>
+        </section>
+        <section class="flash-wrap" aria-label="Flashcard">
+          <div class="flash-inner" id="flashInner">
+            <div class="flash-face flash-front"><span class="face-tag">QUESTION</span><p id="cardFront"></p></div>
+            <div class="flash-face flash-back"><span class="face-tag">ANSWER</span><p id="cardBack"></p></div>
+          </div>
+        </section>
+        <p class="flip-hint" id="flipHint">Click the card or press <kbd>Space</kbd> to reveal</p>
+        <section class="glass-card grades hidden" id="gradeBox" aria-label="Grade recall">
+          <button class="grade g-again" data-grade="again">✕ Again <kbd>1</kbd></button>
+          <button class="grade g-hard" data-grade="hard">😅 Hard <kbd>2</kbd></button>
+          <button class="grade g-good" data-grade="good">👍 Good <kbd>3</kbd></button>
+          <button class="grade g-easy" data-grade="easy">🚀 Easy <kbd>4</kbd></button>
+        </section>
+      </div>
+    </main>
+
+    <!-- Deck modal -->
+    <div class="modal-overlay hidden" id="deckModal">
+      <div class="modal-window glass-card small">
+        <div class="modal-header"><h3 id="deckModalTitle">📚 New Deck</h3><button class="btn-close" data-close="deckModal">✕</button></div>
+        <label class="lbl">Deck name<input type="text" id="deckName" class="field" maxlength="50" placeholder="e.g. JavaScript Basics" /></label>
+        <div class="modal-footer">
+          <button class="btn-ghost danger hidden" id="btnDeleteDeck">Delete</button>
+          <div><button class="btn-ghost" data-close="deckModal">Cancel</button><button class="btn-primary" id="btnSaveDeck">Save</button></div>
+        </div>
+      </div>
+    </div>
+
+    <!-- Card modal -->
+    <div class="modal-overlay hidden" id="cardModal">
+      <div class="modal-window glass-card small">
+        <div class="modal-header"><h3 id="cardModalTitle">＋ New Card</h3><button class="btn-close" data-close="cardModal">✕</button></div>
+        <div class="modal-body">
+          <label class="lbl">Deck<select id="cardDeck" class="field"></select></label>
+          <label class="lbl">Front (question)<textarea id="cardFrontInput" class="field" rows="3" maxlength="400"></textarea></label>
+          <label class="lbl">Back (answer)<textarea id="cardBackInput" class="field" rows="3" maxlength="600"></textarea></label>
+        </div>
+        <div class="modal-footer">
+          <button class="btn-ghost danger hidden" id="btnDeleteCard">Delete</button>
+          <div><button class="btn-ghost" data-close="cardModal">Cancel</button><button class="btn-primary" id="btnSaveCard">Save</button></div>
+        </div>
+      </div>
+    </div>
+
+    <!-- Deck detail modal -->
+    <div class="modal-overlay hidden" id="detailModal">
+      <div class="modal-window glass-card">
+        <div class="modal-header"><h3 id="detailTitle">Deck</h3><button class="btn-close" data-close="detailModal">✕</button></div>
+        <div class="detail-list" id="detailList"></div>
+        <div class="modal-footer end"><button class="btn-primary" data-close="detailModal">Done</button></div>
+      </div>
+    </div>
+
+    <div class="toast-container" id="toastContainer"></div>
+    <script src="app.js"></script>
+  </body>
+</html>
diff --git a/projects/26-memodeck/styles.css b/projects/26-memodeck/styles.css
new file mode 100644
index 0000000..7386b09
--- /dev/null
+++ b/projects/26-memodeck/styles.css
@@ -0,0 +1,104 @@
+/* MemoDeck (#26) | Flashcard Study System */
+:root {
+  --font-main: "Outfit", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+  --font-mono: "JetBrains Mono", Menlo, monospace;
+  --bg: #0b0f19; --surface: rgba(18, 24, 38, 0.75); --surface-solid: #121826;
+  --border: rgba(255, 255, 255, 0.1); --text: #f8fafc; --muted: #94a3b8; --dim: #64748b;
+  --accent: #6366f1; --accent-hover: #4f46e5; --green: #10b981; --red: #ef4444; --amber: #f59e0b;
+  --r-sm: 8px; --r-md: 14px; --r-lg: 22px; --r-full: 9999px;
+  --shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.6); --t: 0.15s ease;
+}
+*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
+body { font-family: var(--font-main); background: var(--bg);
+  background-image: radial-gradient(circle at 12% 0%, rgba(236,72,153,0.12), transparent 55%), radial-gradient(circle at 90% 100%, rgba(99,102,241,0.15), transparent 55%);
+  background-attachment: fixed; color: var(--text); min-height: 100vh; display: flex; flex-direction: column; -webkit-font-smoothing: antialiased; }
+.md-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.85rem 1.4rem; border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 40; background: rgba(11,15,25,0.88); backdrop-filter: blur(16px); flex-wrap: wrap; }
+.header-left { display: flex; align-items: center; gap: 0.9rem; }
+.nav-hub-btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.95rem; background: var(--surface); border: 1px solid var(--border); color: var(--text); border-radius: var(--r-full); text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: all var(--t); }
+.nav-hub-btn:hover { background: rgba(255,255,255,0.12); transform: translateX(-3px); }
+.brand { display: flex; align-items: center; gap: 0.55rem; }
+.brand-badge { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.5rem; background: rgba(236,72,153,0.2); color: #f9a8d4; border-radius: var(--r-sm); }
+.brand-title { font-size: 1.1rem; font-weight: 800; }
+.header-right { display: flex; align-items: center; gap: 0.5rem; }
+.hdr-btn { background: var(--accent); color: #fff; border: none; border-radius: var(--r-md); padding: 0.5rem 1rem; font-family: var(--font-main); font-size: 0.82rem; font-weight: 700; cursor: pointer; transition: all var(--t); }
+.hdr-btn:hover { background: var(--accent-hover); transform: translateY(-2px); }
+.icon-btn { min-width: 38px; height: 38px; padding: 0 0.5rem; border-radius: var(--r-full); background: var(--surface); border: 1px solid var(--border); color: var(--text); display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 1rem; transition: all var(--t); }
+.icon-btn:hover { background: rgba(255,255,255,0.14); transform: translateY(-2px); }
