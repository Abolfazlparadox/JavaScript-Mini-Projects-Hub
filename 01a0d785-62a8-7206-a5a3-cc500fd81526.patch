+/* ==========================================================
+   Markdown Live Studio (#15) | Split-Pane Editor & Preview
+   ========================================================== */
+:root {
+  --font-main: "Outfit", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+  --font-mono: "JetBrains Mono", Menlo, monospace;
+  --bg: #0b0f19;
+  --surface: rgba(18, 24, 38, 0.75);
+  --surface-solid: #121826;
+  --border: rgba(255, 255, 255, 0.1);
+  --text: #f8fafc;
+  --muted: #94a3b8;
+  --dim: #64748b;
+  --accent: #6366f1;
+  --accent-hover: #4f46e5;
+  --green: #10b981;
+  --r-sm: 8px; --r-md: 12px; --r-full: 9999px;
+  --shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.6);
+  --t: 0.15s ease;
+}
+*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
+html, body { height: 100%; }
+body { font-family: var(--font-main); background: var(--bg); color: var(--text); display: flex; flex-direction: column; height: 100vh; overflow: hidden; -webkit-font-smoothing: antialiased; }
+/* Header */
+.md-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.7rem 1.2rem; border-bottom: 1px solid var(--border); background: rgba(11,15,25,0.9); z-index: 40; flex-shrink: 0; }
+.header-left { display: flex; align-items: center; gap: 0.9rem; min-width: 0; }
+.nav-hub-btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.95rem; background: var(--surface); border: 1px solid var(--border); color: var(--text); border-radius: var(--r-full); text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: all var(--t); flex-shrink: 0; }
+.nav-hub-btn:hover { background: rgba(255,255,255,0.12); transform: translateX(-3px); }
+.brand { display: flex; align-items: center; gap: 0.55rem; white-space: nowrap; }
+.brand-badge { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.5rem; background: rgba(16,185,129,0.18); color: #6ee7b7; border-radius: var(--r-sm); }
+.brand-title { font-size: 1.05rem; font-weight: 800; letter-spacing: -0.02em; }
+.header-right { display: flex; align-items: center; gap: 0.45rem; }
+.view-switch { display: flex; background: rgba(0,0,0,0.35); border: 1px solid var(--border); border-radius: var(--r-full); padding: 0.18rem; }
+.view-btn { background: transparent; border: none; color: var(--muted); font-size: 0.95rem; width: 34px; height: 30px; border-radius: var(--r-full); cursor: pointer; transition: all var(--t); }
+.view-btn.active { background: var(--accent); color: #fff; }
+.icon-btn { width: 36px; height: 36px; border-radius: var(--r-full); background: var(--surface); border: 1px solid var(--border); color: var(--text); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all var(--t); }
+.icon-btn:hover { background: rgba(255,255,255,0.14); transform: translateY(-2px); }
+.md-mini { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; }
+/* Toolbar */
+.toolbar { display: flex; align-items: center; gap: 0.3rem; padding: 0.5rem 1rem; border-bottom: 1px solid var(--border); background: rgba(18,24,38,0.6); overflow-x: auto; flex-shrink: 0; scrollbar-width: thin; }
+.toolbar button { background: transparent; border: 1px solid transparent; color: var(--muted); font-family: var(--font-mono); font-size: 0.78rem; font-weight: 600; padding: 0.35rem 0.6rem; border-radius: var(--r-sm); cursor: pointer; white-space: nowrap; transition: all var(--t); }
+.toolbar button:hover { color: var(--text); background: rgba(255,255,255,0.08); border-color: var(--border); }
+.toolbar button.danger:hover { color: #fca5a5; border-color: rgba(239,68,68,0.4); }
+.toolbar .sep { width: 1px; height: 20px; background: var(--border); margin: 0 0.25rem; flex-shrink: 0; }
+/* Stage */
+.md-stage { flex: 1; display: grid; grid-template-columns: 1fr 1fr; min-height: 0; }
+.md-stage.view-editor { grid-template-columns: 1fr; }
+.md-stage.view-editor .preview-pane { display: none; }
+.md-stage.view-preview { grid-template-columns: 1fr; }
+.md-stage.view-preview .editor-pane { display: none; }
+.pane { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
+.editor-pane { border-right: 1px solid var(--border); }
+.view-editor .editor-pane, .view-preview .preview-pane { border-right: none; }
+.pane-head { display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 1rem; font-family: var(--font-mono); font-size: 0.74rem; color: var(--dim); border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.25); flex-shrink: 0; }
+.save-state { color: var(--green); }
+.save-state.dirty { color: #fbbf24; }
+.sync-toggle { display: flex; align-items: center; gap: 0.35rem; cursor: pointer; font-size: 0.72rem; }
+.sync-toggle input { accent-color: var(--accent); }
+#editor { flex: 1; background: rgba(0,0,0,0.3); border: none; outline: none; resize: none; color: #e2e8f0; font-family: var(--font-mono); font-size: 0.88rem; line-height: 1.7; padding: 1.1rem 1.25rem; }
+.markdown-body { flex: 1; overflow-y: auto; padding: 1.5rem 2rem 3rem; line-height: 1.75; font-size: 0.93rem; max-width: 860px; }
+/* Rendered markdown */
+.markdown-body h1, .markdown-body h2 { border-bottom: 1px solid var(--border); padding-bottom: 0.4rem; margin: 1.4rem 0 0.8rem; line-height: 1.3; }
+.markdown-body h1 { font-size: 1.8rem; } .markdown-body h2 { font-size: 1.45rem; }
+.markdown-body h3 { font-size: 1.2rem; margin: 1.2rem 0 0.6rem; }
+.markdown-body h4 { font-size: 1.02rem; margin: 1rem 0 0.5rem; color: #c4b5fd; }
+.markdown-body p { margin: 0.6rem 0; color: #dbe2ee; }
+.markdown-body a { color: #818cf8; text-decoration: none; border-bottom: 1px dashed rgba(129,140,248,0.5); }
+.markdown-body a:hover { color: #a5b4fc; }
+.markdown-body strong { color: #fff; } .markdown-body em { color: #e2e8f0; }
+.markdown-body code:not(.codeblock code) { font-family: var(--font-mono); font-size: 0.82em; background: rgba(99,102,241,0.15); border: 1px solid rgba(99,102,241,0.3); color: #c7d2fe; padding: 0.1rem 0.4rem; border-radius: 6px; }
+.markdown-body pre.codeblock { position: relative; background: #020617; border: 1px solid var(--border); border-radius: var(--r-md); padding: 1rem 1.1rem; overflow-x: auto; margin: 0.9rem 0; }
+.markdown-body pre.codeblock code { font-family: var(--font-mono); font-size: 0.82rem; line-height: 1.65; color: #dbe2ee; background: none; border: none; padding: 0; }
+.code-lang { position: absolute; top: 0.45rem; right: 0.7rem; font-family: var(--font-mono); font-size: 0.65rem; color: var(--dim); text-transform: uppercase; letter-spacing: 0.08em; }
+.tok-kw { color: #c792ea; } .tok-str { color: #9ece6a; } .tok-com { color: #565f89; font-style: italic; } .tok-num { color: #ff9e64; } .tok-fn { color: #7aa2f7; }
+.markdown-body blockquote { border-left: 4px solid var(--accent); background: rgba(99,102,241,0.08); margin: 0.9rem 0; padding: 0.7rem 1rem; border-radius: 0 var(--r-sm) var(--r-sm) 0; color: #c9d3e8; }
+.markdown-body blockquote p { margin: 0.25rem 0; }
+.markdown-body ul, .markdown-body ol { margin: 0.6rem 0 0.6rem 1.4rem; color: #dbe2ee; }
+.markdown-body li { margin: 0.3rem 0; }
+.markdown-body li.task { list-style: none; margin-left: -1.4rem; }
+.markdown-body hr { border: none; border-top: 2px solid var(--border); margin: 1.4rem 0; }
+.markdown-body table { width: 100%; border-collapse: collapse; margin: 0.9rem 0; font-size: 0.86rem; }
+.markdown-body th, .markdown-body td { border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left; }
+.markdown-body th { background: rgba(99,102,241,0.15); font-weight: 700; }
+.markdown-body tr:nth-child(even) td { background: rgba(255,255,255,0.02); }
+.markdown-body img { max-width: 100%; border-radius: var(--r-md); border: 1px solid var(--border); }
+/* Statusbar */
+.statusbar { display: flex; align-items: center; gap: 1.2rem; padding: 0.5rem 1.2rem; border-top: 1px solid var(--border); background: rgba(18,24,38,0.8); font-size: 0.76rem; color: var(--muted); flex-shrink: 0; }
+.statusbar strong { color: var(--text); font-family: var(--font-mono); }
+.statusbar .spacer { flex: 1; }
+.statusbar .hint { font-family: var(--font-mono); font-size: 0.68rem; color: var(--dim); }
+/* Toast */
+.toast-container { position: fixed; bottom: 3rem; right: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; z-index: 200; }
+.toast { background: #1e293b; border: 1px solid var(--border); color: var(--text); padding: 0.65rem 1.15rem; border-radius: var(--r-full); font-size: 0.85rem; font-weight: 600; box-shadow: var(--shadow); }
+.toast.success { border-color: rgba(16,185,129,0.5); }
+.hidden { display: none !important; }
+@media (max-width: 820px) {
+  .md-stage { grid-template-columns: 1fr !important; }
+  .md-stage.view-split .editor-pane { display: flex; }
+  .md-stage.view-split .preview-pane { display: none; }
+  .md-stage.view-split.mobile-preview .editor-pane { display: none; }
+  .md-stage.view-split.mobile-preview .preview-pane { display: flex; }
+  .editor-pane { border-right: none; }
+  .statusbar .hint { display: none; }
+  .brand-title { font-size: 0.92rem; }
+  .markdown-body { padding: 1.1rem 1.2rem 3rem; }
+}
+/* Print: preview only, light friendly */
+@media print {
+  body { height: auto; overflow: visible; background: #fff; color: #111; display: block; }
+  .md-header, .toolbar, .statusbar, .editor-pane, .toast-container, .pane-head { display: none !important; }
+  .md-stage { display: block; }
+  .markdown-body { max-width: 100%; color: #111; }
+  .markdown-body p, .markdown-body li { color: #222; }
+  .markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body strong { color: #000; }
+  .markdown-body pre.codeblock { background: #f4f4f5; border-color: #ddd; }
+  .markdown-body pre.codeblock code { color: #111; }
+}
