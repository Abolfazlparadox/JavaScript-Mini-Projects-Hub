+    <meta name="description" content="Multi-zone world clock with analog canvas, precision stopwatch with laps, and countdown timer with alarm." />
+    <link rel="preconnect" href="https://fonts.googleapis.com" />
+    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
+    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
+    <link rel="stylesheet" href="styles.css" />
+  </head>
+  <body>
+    <header class="tw-header">
+      <div class="header-left">
+        <a href="../../index.html" class="nav-hub-btn" title="Return to Projects Hub">
+          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
+          <span>Hub</span>
+        </a>
+        <div class="brand"><span class="brand-badge">#24</span><span class="brand-title">TimeWarp Studio</span></div>
+      </div>
+      <div class="header-right">
+        <button class="icon-btn" id="btnSound" title="Toggle sound">🔊</button>
+      </div>
+    </header>
+
+    <main class="tw-stage">
+      <div class="tw-shell">
+        <div class="mode-tabs" id="modeTabs" role="tablist">
+          <button class="mode-btn active" data-tab="clock">🕰️ World Clock</button>
+          <button class="mode-btn" data-tab="stopwatch">⏱️ Stopwatch</button>
+          <button class="mode-btn" data-tab="countdown">⏳ Countdown</button>
+        </div>
+
+        <!-- World clock -->
+        <section id="tab-clock">
+          <div class="glass-card hero-clock">
+            <canvas id="analogCanvas"></canvas>
+            <div class="hero-digital">
+              <span class="hero-time" id="localTime">--:--:--</span>
+              <span class="hero-date" id="localDate">—</span>
+              <span class="hero-tz" id="localTz">Local time</span>
+            </div>
+          </div>
+          <div class="glass-card">
+            <div class="zone-head"><h2>🌍 Time Zones</h2>
+              <div class="zone-add">
+                <select id="zoneSelect" class="field field-sm"></select>
+                <button class="btn-ghost sm" id="btnAddZone">＋ Add</button>
+              </div>
+            </div>
+            <div class="zone-grid" id="zoneGrid"></div>
