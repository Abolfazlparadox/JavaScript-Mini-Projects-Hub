+              <label class="check"><input type="checkbox" id="optDigits" checked /> 123 <span>digits</span></label>
+              <label class="check"><input type="checkbox" id="optSymbols" checked /> #$& <span>symbols</span></label>
+              <label class="check"><input type="checkbox" id="optAmbiguous" checked /> ⊘ <span>exclude ambiguous <em>0O1lI|</em></span></label>
+            </div>
+          </div>
+          <div id="passphraseOpts" class="hidden">
