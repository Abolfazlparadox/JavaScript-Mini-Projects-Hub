+/* ============================================================
+   ALIVENESS LAYER — particles, aurora, typewriter, reveal,
+   tilt/spotlight, marquee, random button (additive only)
+   ============================================================ */
+.hub-particles {
+  position: fixed;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  z-index: 0;
+  pointer-events: none;
+  opacity: 0.75;
+}
+
+.hub-header,
+.hub-main,
+.hub-footer {
+  position: relative;
+  z-index: 1;
+}
+
+/* Animated aurora ribbon behind the hero */
+.hero-section {
+  position: relative;
+}
+.hero-section::before {
+  content: "";
+  position: absolute;
+  inset: -60px -40px auto -40px;
+  height: 340px;
+  background:
+    radial-gradient(ellipse 45% 60% at 20% 40%, rgba(99, 102, 241, 0.16), transparent 70%),
+    radial-gradient(ellipse 40% 55% at 75% 60%, rgba(16, 185, 129, 0.13), transparent 70%),
+    radial-gradient(ellipse 35% 50% at 50% 20%, rgba(236, 72, 153, 0.1), transparent 70%);
+  filter: blur(10px);
+  animation: aurora-drift 14s ease-in-out infinite alternate;
+  pointer-events: none;
+  z-index: -1;
+}
+@keyframes aurora-drift {
+  0% { transform: translateX(-3%) scale(1); opacity: 0.8; }
+  100% { transform: translateX(3%) scale(1.06); opacity: 1; }
+}
+
+/* Typewriter line + live clock */
+.hero-typewriter {
+  margin-top: 0.9rem;
+  font-family: var(--font-mono, "JetBrains Mono", monospace);
+  font-size: 0.95rem;
+  color: var(--accent-primary, #818cf8);
+  min-height: 1.5em;
+}
+.hero-typewriter .type-caret {
+  display: inline-block;
+  animation: caret-blink 1s steps(1) infinite;
+  color: var(--accent-primary, #818cf8);
+}
+@keyframes caret-blink {
+  0%, 50% { opacity: 1; }
+  51%, 100% { opacity: 0; }
+}
+.hero-live-row {
+  display: flex;
+  align-items: center;
+  gap: 0.6rem;
+  margin-top: 0.55rem;
+  font-size: 0.8rem;
+  color: var(--text-muted, #94a3b8);
+  font-family: var(--font-mono, "JetBrains Mono", monospace);
+}
+.live-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: #10b981;
+  box-shadow: 0 0 8px #10b981;
+  animation: live-pulse 2s ease-in-out infinite;
+}
+@keyframes live-pulse {
+  0%, 100% { transform: scale(1); opacity: 1; }
+  50% { transform: scale(1.5); opacity: 0.55; }
+}
+
+/* Tech marquee */
+.tech-marquee {
+  overflow: hidden;
+  white-space: nowrap;
+  border-top: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
+  border-bottom: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
+  padding: 0.6rem 0;
+  margin: 0 0 0.5rem 0;
+  mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
+  -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
+}
+.tech-marquee-track {
+  display: inline-block;
+  animation: marquee-scroll 36s linear infinite;
+  font-size: 0.78rem;
+  font-weight: 600;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--text-muted, #64748b);
+}
+.tech-marquee-track span {
+  margin: 0 1.4rem;
+}
+@keyframes marquee-scroll {
+  0% { transform: translateX(0); }
+  100% { transform: translateX(-50%); }
+}
+
+/* Scroll reveal */
+.reveal {
+  opacity: 0;
+  transform: translateY(26px);
+  transition: opacity 0.55s ease, transform 0.55s ease;
+}
+.reveal.revealed {
+  opacity: 1;
+  transform: none;
+}
+
+/* Card tilt + spotlight (vars set from JS) */
+.project-card {
+  transform-style: preserve-3d;
+  will-change: transform;
+  position: relative;
+}
+.project-card::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgba(129, 140, 248, 0.12), transparent 65%);
+  opacity: 0;
+  transition: opacity 0.25s ease;
+  pointer-events: none;
+}
+.project-card:hover::after {
+  opacity: 1;
+}
+
+/* Random button */
+.btn-random {
+  background: linear-gradient(135deg, #6366f1, #8b5cf6);
+  color: #fff;
+  border: none;
+  border-radius: 999px;
+  padding: 0.45rem 1.1rem;
+  font-family: inherit;
+  font-size: 0.82rem;
+  font-weight: 700;
+  cursor: pointer;
+  transition: transform 0.15s ease, box-shadow 0.15s ease;
+  box-shadow: 0 4px 16px rgba(99, 102, 241, 0.35);
+}
+.btn-random:hover {
+  transform: translateY(-2px) rotate(-2deg);
+  box-shadow: 0 8px 22px rgba(99, 102, 241, 0.5);
+}
+.section-meta-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+  flex-wrap: wrap;
+}
+
+/* Stat count-up pop */
+.stat-number.counting {
+  color: var(--accent-primary, #818cf8);
+}
+
+/* Reduced motion: disable all aliveness animation */
+@media (prefers-reduced-motion: reduce) {
+  .hub-particles,
+  .hero-section::before,
+  .tech-marquee-track,
+  .hero-typewriter .type-caret,
+  .live-dot {
+    animation: none !important;
+    display: none;
+  }
+  .hero-typewriter,
+  .hero-live-row {
+    display: none;
+  }
+  .reveal {
+    opacity: 1;
+    transform: none;
+    transition: none;
+  }
+  .project-card::after {
+    display: none;
+  }
+}
+
