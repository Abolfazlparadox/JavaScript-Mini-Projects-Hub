diff --git a/projects/23-regexlab/styles.css b/projects/23-regexlab/styles.css
new file mode 100644
index 0000000..9aec807
--- /dev/null
+++ b/projects/23-regexlab/styles.css
@@ -0,0 +1,88 @@
+/* RegexLab (#23) | Live Regular Expression Playground */
+:root {
+  --font-main: "Outfit", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+  --font-mono: "JetBrains Mono", Menlo, monospace;
+  --bg: #0b0f19; --surface: rgba(18, 24, 38, 0.75); --surface-solid: #121826;
+  --border: rgba(255, 255, 255, 0.1); --text: #f8fafc; --muted: #94a3b8; --dim: #64748b;
+  --accent: #6366f1; --accent-hover: #4f46e5; --green: #10b981; --red: #ef4444;
+  --r-sm: 8px; --r-md: 14px; --r-lg: 22px; --r-full: 9999px;
+  --shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.6); --t: 0.15s ease;
+}
+*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
+body { font-family: var(--font-main); background: var(--bg);
+  background-image: radial-gradient(circle at 90% 0%, rgba(167,139,250,0.14), transparent 55%), radial-gradient(circle at 5% 100%, rgba(56,189,248,0.1), transparent 55%);
+  background-attachment: fixed; color: var(--text); min-height: 100vh; display: flex; flex-direction: column; -webkit-font-smoothing: antialiased; }
+.rx-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.85rem 1.4rem; border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 40; background: rgba(11,15,25,0.88); backdrop-filter: blur(16px); flex-wrap: wrap; }
+.header-left { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
+.nav-hub-btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.95rem; background: var(--surface); border: 1px solid var(--border); color: var(--text); border-radius: var(--r-full); text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: all var(--t); }
+.nav-hub-btn:hover { background: rgba(255,255,255,0.12); transform: translateX(-3px); }
+.brand { display: flex; align-items: center; gap: 0.55rem; }
+.brand-badge { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.5rem; background: rgba(167,139,250,0.2); color: #c4b5fd; border-radius: var(--r-sm); }
+.brand-title { font-size: 1.1rem; font-weight: 800; }
+.match-pill { font-family: var(--font-mono); font-size: 0.74rem; font-weight: 700; padding: 0.3rem 0.85rem; border-radius: var(--r-full); background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.4); color: #6ee7b7; }
+.match-pill.zero { background: rgba(255,255,255,0.05); border-color: var(--border); color: var(--dim); }
+.header-right { display: flex; gap: 0.5rem; }
+.icon-btn { min-width: 38px; height: 38px; padding: 0 0.5rem; border-radius: var(--r-full); background: var(--surface); border: 1px solid var(--border); color: var(--text); display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 1rem; transition: all var(--t); }
+.icon-btn:hover { background: rgba(255,255,255,0.14); transform: translateY(-2px); }
+.rx-stage { flex: 1; display: flex; justify-content: center; padding: 1.6rem 1rem 3rem; }
+.rx-shell { width: 100%; max-width: 980px; display: flex; flex-direction: column; gap: 1rem; }
+.glass-card { background: var(--surface); border: 1px solid var(--border); backdrop-filter: blur(20px); border-radius: var(--r-lg); box-shadow: var(--shadow); padding: 1.25rem 1.35rem; }
+.glass-card h2 { font-size: 1rem; margin-bottom: 0.8rem; }
+.glass-card h2 .sub { font-size: 0.74rem; color: var(--dim); font-weight: 500; font-family: var(--font-mono); }
+.pattern-row { display: flex; align-items: center; gap: 0.5rem; background: #020617; border: 1px solid var(--border); border-radius: var(--r-md); padding: 0.6rem 0.9rem; }
+.pattern-row:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(99,102,241,0.2); }
+.slash { color: var(--accent); font-family: var(--font-mono); font-weight: 700; font-size: 1.1rem; }
+.pattern-input { flex: 1; background: transparent; border: none; outline: none; color: #e2e8f0; font-family: var(--font-mono); font-size: 1rem; min-width: 0; }
+.flags { display: flex; gap: 0.25rem; flex-shrink: 0; }
+.flags label { display: flex; align-items: center; gap: 0.25rem; font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; color: var(--dim); background: rgba(255,255,255,0.05); border: 1px solid var(--border); border-radius: 6px; padding: 0.25rem 0.5rem; cursor: pointer; transition: all var(--t); }
+.flags label:has(input:checked) { color: #fff; background: rgba(99,102,241,0.3); border-color: var(--accent); }
+.flags input { accent-color: var(--accent); }
+.rx-error { margin-top: 0.6rem; font-family: var(--font-mono); font-size: 0.78rem; color: #fca5a5; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.35); border-radius: var(--r-sm); padding: 0.5rem 0.75rem; }
+.quick-row { display: flex; gap: 0.45rem; flex-wrap: wrap; margin-top: 0.8rem; }
+.quick-row button { background: rgba(255,255,255,0.05); border: 1px solid var(--border); color: var(--muted); font-family: var(--font-mono); font-size: 0.72rem; padding: 0.35rem 0.7rem; border-radius: var(--r-full); cursor: pointer; transition: all var(--t); }
+.quick-row button:hover { color: var(--text); border-color: var(--accent); background: rgba(99,102,241,0.15); }
+.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
+#testInput { width: 100%; min-height: 220px; background: rgba(0,0,0,0.35); border: 1px solid var(--border); border-radius: var(--r-md); color: #e2e8f0; font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.7; padding: 0.8rem 0.9rem; outline: none; resize: vertical; }
+#testInput:focus { border-color: var(--accent); }
+.highlight-box { min-height: 150px; max-height: 220px; overflow-y: auto; background: rgba(0,0,0,0.35); border: 1px solid var(--border); border-radius: var(--r-md); padding: 0.8rem 0.9rem; font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.9; white-space: pre-wrap; word-break: break-word; }
+.highlight-box mark { background: rgba(99,102,241,0.55); color: #fff; border-radius: 4px; padding: 1px 2px; }
+.highlight-box mark:nth-of-type(even) { background: rgba(16,185,129,0.5); }
+.dim { color: var(--dim); font-size: 0.82rem; }
+.groups-list { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 0.7rem; max-height: 170px; overflow-y: auto; }
+.group-card { background: rgba(0,0,0,0.3); border: 1px solid var(--border); border-radius: var(--r-sm); padding: 0.5rem 0.7rem; font-family: var(--font-mono); font-size: 0.76rem; }
+.group-card b { color: #a5b4fc; }
+.group-card .g { color: #9ece6a; }
